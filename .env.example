MONGODB_URI="mongodb://127.0.0.1:27017/confeitaria"
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Criptografia de tokens em repouso (Access Token / webhook secret do MP).
# Se omitido, usa AUTH_SECRET. Recomendado: 32+ bytes aleatórios.
# TOKEN_ENCRYPTION_KEY="another-long-random-secret"

# Mercado Pago: cada loja configura Public Key + Access Token (+ segredo do webhook)
# em /painel/configuracoes/pagamento. Webhook (produção):
# https://seu-dominio/api/payments/webhook
#
# Segredo global opcional (Suas integrações → Webhooks). Alternativa: salvar
# o segredo por loja no painel.
# MP_WEBHOOK_SECRET=""

# E-mail (recuperação de senha + notificações). Sem SMTP, o conteúdo é logado no console.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="DocePedido <noreply@seudominio.com>"

# WhatsApp (notificações reais). Configure UMA das opções:
# Meta Cloud API:
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# Evolution API:
# WHATSAPP_EVOLUTION_URL="http://localhost:8080"
# WHATSAPP_EVOLUTION_INSTANCE="loja"
# WHATSAPP_EVOLUTION_KEY=""
# Webhook genérico:
# WHATSAPP_WEBHOOK_URL=""
# WHATSAPP_WEBHOOK_TOKEN=""
